# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# --- Plaid (banks, cards, brokerages, loans) ---
# From https://dashboard.plaid.com → Developers → Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (fake test data) or production (your real accounts)
PLAID_ENV=sandbox

# --- Splitwise (optional: API access requires Splitwise Pro) ---
# Without it, use the weekly screenshot import (see README).
# Register an app at https://secure.splitwise.com/apps and copy its API key
SPLITWISE_API_KEY=

# --- Optional: SimpleFIN Bridge backup ---
# Setup token from https://bridge.simplefin.org (exchanged once for an access URL)
SIMPLEFIN_SETUP_TOKEN=
